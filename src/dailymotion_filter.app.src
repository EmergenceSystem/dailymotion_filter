{application, dailymotion_filter, [
    {description, "em_filter example for Dailymotion"},
    {vsn, "0.2.0"},
    {registered, [dailymotion_filter_sup, dailymotion_filter_server]},
    {mod, {dailymotion_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        dailymotion_filter_sup,
        dailymotion_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/dailymotion_filter"}]}
]}.
